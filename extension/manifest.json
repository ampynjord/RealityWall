{
  "manifest_version": 3,
  "name": "RealityWall",
  "version": "1.3.0",
  "description": "Sélectionnez un texte, clic droit (ou icône), débunkez. Un mur de faits infranchissable face à la mauvaise foi numérique.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "RealityWall — analyser la sélection (ou la page entière)"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["prompts.js", "core.js", "background.js"]
  },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["context.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "analyze": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Analyser la sélection ou la page avec RealityWall"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "realitywall@ampynjord.github.io",
      "strict_min_version": "115.0"
    },
    "gecko_android": {
      "strict_min_version": "115.0"
    }
  }
}
