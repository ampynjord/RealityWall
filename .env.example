# Copiez ce fichier en .env puis renseignez votre clé API Anthropic.
# `make install` effectue automatiquement cette copie si .env n'existe pas.

# Obligatoire : clé API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# Optionnel : modèle Claude utilisé par le moteur d'analyse
ANTHROPIC_MODEL=claude-sonnet-5

# Optionnel : interface et port d'écoute du backend
HOST=0.0.0.0
PORT=8000

# Optionnel : regex des origines autorisées en CORS (extension navigateur)
CORS_ORIGIN_REGEX=^(chrome-extension|moz-extension)://.*$|^https?://localhost(:\d+)?$|^https?://127\.0\.0\.1(:\d+)?$

# Optionnel : nombre max. de caractères du texte envoyé au modèle
MAX_INPUT_CHARS=4000
